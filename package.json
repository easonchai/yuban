{
  "name": "yuban-app",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --filter ./apps/* build",
    "test": "pnpm --filter server test",
    "typecheck": "pnpm --filter ./apps/* typecheck",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "devDependencies": {
    "prisma": "^6.6.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0"
  }
}
