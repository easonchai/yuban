generator client {
  provider = "prisma-client-js"
  // native = dev machine; the linux targets cover the docker runtime (slim
  // images detect openssl 3) on arm64 and a future x86_64 deploy.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Learner {
  id          BigInt    @id // Telegram user id
  username    String    @default("")
  mode        String    @default("casual") // casual | study
  pingsPerDay Int       @default(2)
  nextPingAt  DateTime?
  expiry      DateTime? // null = never active (admin bypasses in code)
  profileMd   String    @default("") // model-owned About/Level/Contexts/Style
  streak      Int       @default(0)
  lastActive  DateTime? // last day (UTC date) a web activity was completed
  createdAt   DateTime  @default(now())

  vocab    Vocab[]
  messages Message[]
  sessions WebSession[]
  moments  Moment[]
  threads  Thread[]
}

model Vocab {
  id         Int      @id @default(autoincrement())
  learnerId  BigInt
  word       String
  pinyin     String
  gloss      String
  context    String   @default("general")
  strength   Int      @default(1)
  introduced DateTime @default(now())
  lastSeen   DateTime @default(now())

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, word])
  @@index([learnerId, strength, lastSeen])
}

model Message {
  id        Int      @id @default(autoincrement())
  learnerId BigInt
  role      String // user | assistant
  content   String
  ts        DateTime @default(now())

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, id])
}

model Code {
  code      String    @id
  createdAt DateTime  @default(now())
  usedBy    BigInt?
  usedAt    DateTime?
}

model WebSession {
  token     String   @id
  learnerId BigInt? // null = web-first link session awaiting a Telegram claim
  createdAt DateTime @default(now())
  expiresAt DateTime
  consumed  Boolean  @default(false) // magic link consumed / link claimed -> cookie issued

  learner Learner? @relation(fields: [learnerId], references: [id], onDelete: Cascade)
}

// Episodic memory: things that HAPPENED, not facts about who they are (those
// live in Learner.profileMd). The newest ones ride in the system prompt so she
// can call back to a real event instead of asking "how was your day" again.
model Moment {
  id        Int      @id @default(autoincrement())
  learnerId BigInt
  text      String // one past-tense sentence
  feeling   String   @default("") // their mood at the time, the model's read
  ts        DateTime @default(now())

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, id])
}

// Open loops: something she said she'd ask about later. The ping scheduler
// prefers a due thread over a generic opener, which is the whole difference
// between a notification and someone remembering.
model Thread {
  id        Int       @id @default(autoincrement())
  learnerId BigInt
  text      String // "how the vendor call went"
  askAfter  DateTime
  closedAt  DateTime? // stamped when asked (see ponytail note in bot.ts)
  createdAt DateTime  @default(now())

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, closedAt, askAfter])
}
