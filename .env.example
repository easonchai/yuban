# Telegram bot token (same @yubantestbot token, or a fresh one). One poller
# per token — stop the Python bot before starting this one.
TELEGRAM_BOT_TOKEN=REPLACE_ME
# Your numeric Telegram id — always active, gets admin stats
ADMIN_TG_ID=REPLACE_ME

# LLM (OpenAI-compatible)
DEEPSEEK_API_KEY=REPLACE_ME
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# ---- LLM engine ----
# gemma (local ollama, free, private — the default) or deepseek (cloud).
# Admin can also swap live with /engine gemma|deepseek in Telegram.
LLM_PROVIDER=gemma
# Pick the Gemma size for YOUR device, then `ollama pull <tag>`:
#   gemma4:e2b   ~2.9GB  phones / tiny machines
#   gemma4:e4b   ~4.5GB  phones / 8GB laptops
#   gemma4:12b   ~6.7GB  16GB+ laptops (recommended default)
#   gemma4:26b  ~14.4GB  32GB+ machines — MoE, near-31B quality, still fast
#   gemma4:31b  ~17.5GB  GPU servers
# GEMMA_MODEL=gemma4:12b
# OLLAMA_ORIGIN=http://localhost:11434   # compose overrides to host.docker.internal

# Postgres (compose default; override for local dev)
DATABASE_URL=postgresql://yuban:yuban@localhost:5433/yuban

# Web app public origin (magic links point here)
WEB_ORIGIN=http://localhost:3000

# ---- Optional ----
# GROQ_API_KEY=            # enables voice-note transcription (whisper-large-v3)
# TTS is OPTIONAL to configure: with no keys at all you get Microsoft Edge's
# Xiaoxiao, a native-Mandarin voice, free forever. Add an ElevenLabs key and
# it is tried FIRST (Sarah on eleven_v3 by default); any failure — no key,
# quota used up, network down — falls back to Xiaoxiao automatically.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE=EXAVITQu4vr4xnSDxMaL   # Sarah (free-tier accessible)
# ELEVENLABS_MODEL=eleven_v3
# TTS_PROVIDER=edge        # set to force Xiaoxiao even when a key exists
# TZ_OFFSET_MIN=480        # learner-local timezone for ping window
# PINGS_PER_DAY=2
# ENABLE_SUBSCRIBE=0       # paid /subscribe endpoint (Starchild/x402 phase)
